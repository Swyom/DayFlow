# Copy to .env and fill in. .env is gitignored: never commit it.
# EXPO_PUBLIC_* values are compiled into the app bundle, so only public, client-safe values
# belong here. NEVER put the Supabase service_role key or any other secret in this file.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# AdMob. Keep test mode on until your AdMob account, app and ad units are approved.
EXPO_PUBLIC_ADMOB_TEST_MODE=true
EXPO_PUBLIC_ADMOB_BANNER_ID_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_ID_IOS=
# AdMob app IDs, read by app.config.js at build time (empty = Google's sample app IDs).
ADMOB_APP_ID_ANDROID=
ADMOB_APP_ID_IOS=
