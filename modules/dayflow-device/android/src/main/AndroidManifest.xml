<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Step counter sensor (runtime permission on Android 10+). -->
  <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

  <!-- Screen time: granted by the user in Settings → Usage access, never automatically. -->
  <uses-permission
    android:name="android.permission.PACKAGE_USAGE_STATS"
    tools:ignore="ProtectedPermissions" />

  <!-- Lets usage stats show app names for launchable apps (Android 11+ package visibility)
       without the broad QUERY_ALL_PACKAGES permission. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>
</manifest>
